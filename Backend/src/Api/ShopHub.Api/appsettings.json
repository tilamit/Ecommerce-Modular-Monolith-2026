{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Caching": {
    "DefaultExpirationMinutes": 5,
    "LocalExpirationMinutes": 2,
    "MaximumPayloadBytes": 1048576
  },
  "Catalog": {
    "ProductImages": {
      "FolderName": "ProductImages",
      "MaxBytesPerFile": 5242880,
      "MaxFilesPerRequest": 10
    }
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 5, "WindowSeconds": 60, "QueueLimit": 0 },
    "Anonymous": { "PermitLimit": 100, "WindowSeconds": 60, "SegmentsPerWindow": 4, "QueueLimit": 0 },
    "Authenticated": { "TokenLimit": 200, "TokensPerPeriod": 50, "ReplenishmentPeriodSeconds": 10, "QueueLimit": 0 },
    "Write": { "PermitLimit": 60, "WindowSeconds": 60, "QueueLimit": 0 },
    "Checkout": { "PermitLimit": 10, "WindowSeconds": 60, "QueueLimit": 0 }
  },
  "AllowedHosts": "*"
}
